# PRANSETU backend configuration — template.
#
# Copy this file to `backend/.env` and fill in the real values, then keep it out
# of git (.gitignore covers `.env` at any depth — verified).
#
#     cp backend/env.example backend/.env
#
# Every value below comes from your Supabase project dashboard. None of them
# should ever be pasted into a chat, a screenshot, or a commit.


# ── Required by app/core/config.py — the API will not start without these ─────

# Project Settings → API → Project URL. Public; safe to expose.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings → API → Project API keys → `service_role`.
# SERVER-ONLY SECRET. Bypasses every row-level security policy in the database.
# Never ship this to the browser or put it in a VITE_* variable.
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Project Settings → API → JWT Settings → JWT Secret.
# SERVER-ONLY SECRET. Leaking it lets anyone forge an authenticated admin token.
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET


# ── Used only to apply supabase/migrations/*.sql — not read by the app ────────

# Project Settings → Database → Connection string → URI.
#
# Pick "Session pooler" (port 5432 on aws-*.pooler.supabase.com), not the
# transaction pooler on 6543 — DDL needs a session-mode connection. The direct
# db.<ref>.supabase.co host is IPv6-only on newer projects, so the pooler is
# usually the only one that resolves from a home connection.
#
# PERCENT-ENCODE the password. If it contains @ : / ? # [ ] or %, an unencoded
# string will fail to parse or silently connect to the wrong host:
#     @ → %40    # → %23    ? → %3F    / → %2F    : → %3A    % → %25
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres


# ── Optional ─────────────────────────────────────────────────────────────────

# Only needed if you exercise the IVR/SMS webhook paths.
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
